# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Required for the Newsletter "Send" feature only ---
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API > service_role key.
# SECRET — never put NEXT_PUBLIC_ in front of this one, and never commit it.
# It's used only inside app/api/newsletter/send/route.ts (server-side) to
# read subscriber emails regardless of RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RESEND_API_KEY: sign up free at https://resend.com, create an API key.
# NEWSLETTER_FROM_EMAIL: the address newsletters are sent from, e.g.
# "Enoch's Outpost <news@yourdomain.com>". Resend requires you to verify
# the domain you send from (Resend dashboard > Domains) before this will
# deliver to real subscribers — their free onboarding@resend.dev address
# only delivers to your own Resend account email, not to subscribers.
RESEND_API_KEY=your-resend-api-key
NEWSLETTER_FROM_EMAIL="Enoch's Outpost <news@yourdomain.com>"
